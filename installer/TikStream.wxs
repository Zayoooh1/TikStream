<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="TikStream"
           Manufacturer="TikStream"
           Version="1.3.7.0"
           UpgradeCode="7F8C3D21-6E94-4A1B-9C52-3E4A7B1D8F02"
           Language="1033"
           Codepage="1252"
           Scope="perMachine">

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of TikStream is already installed." />
    <util:CloseApplication Id="CloseTikStream" Target="TikStream.exe" CloseMessage="yes" RebootPrompt="no" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Remember previous install folder on reinstall/upgrade -->
    <Property Id="PREVIOUS_INSTALLFOLDER">
      <RegistrySearch Id="FindPrevInstallFolder" Root="HKLM" Key="Software\TikStream" Name="InstallFolder" Type="directory" />
    </Property>
    <SetProperty Id="INSTALLFOLDER" Action="SetPrevInstallFolder" Value="[PREVIOUS_INSTALLFOLDER]" Before="CostFinalize" Condition="PREVIOUS_INSTALLFOLDER AND NOT Installed" />

    <Icon Id="TikStreamIcon.ico" SourceFile="TikStream.ico" />
    <Property Id="ARPPRODUCTICON" Value="TikStreamIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Zayoooh1/TikStream" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- Default installer options (Secure="yes" required across UAC in perMachine installs) -->
    <Property Id="INSTALLFOLDER" Secure="yes" />
    <Property Id="INSTALL_STARTMENU" Value="1" Secure="yes" />
    <Property Id="INSTALL_DESKTOP" Value="1" Secure="yes" />
    <Property Id="INSTALL_AUTOSTART" Value="0" Secure="yes" />
    <Property Id="INSTALL_MINIMIZED" Value="0" Secure="yes" />
    <Property Id="LAUNCH_AFTER_INSTALL" Value="1" />

    <!-- Argument passed when 'Start minimized' is checked -->
    <SetProperty Id="SHORTCUT_ARGS" Action="SetShortcutArgsMin" Value="--minimized" After="CostFinalize" Condition="INSTALL_MINIMIZED = 1" />
    <SetProperty Id="AUTOSTART_CMD" Action="SetAutostartMin" Value="&quot;[INSTALLFOLDER]TikStream.exe&quot; --minimized" After="CostFinalize" Condition="INSTALL_MINIMIZED = 1" />
    <SetProperty Id="AUTOSTART_CMD" Action="SetAutostartNorm" Value="&quot;[INSTALLFOLDER]TikStream.exe&quot;" After="CostFinalize" Condition="INSTALL_MINIMIZED &lt;&gt; 1" />

    <!-- Silent reset on fresh install AND full user-data cleanup on uninstall (NOT on upgrade/reinstall) -->
    <SetProperty Id="WixQuietExec64CmdLine"
                 Action="SetResetFreshCmd"
                 Value="&quot;[System64Folder]cmd.exe&quot; /c del /f /q &quot;%APPDATA%\TikStream\settings.json&quot; &quot;%APPDATA%\TikStream\settings.json.tmp&quot; 2&gt;nul &amp; reg delete &quot;HKCU\Software\TikStream\UI2&quot; /f 2&gt;nul"
                 Before="ResetFreshUserData"
                 Sequence="execute"
                 Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT REMOVE" />
    <CustomAction Id="ResetFreshUserData"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec64"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />

    <SetProperty Id="WixQuietExec64CmdLine"
                 Action="SetPurgeUninstallCmd"
                 Value="&quot;[System64Folder]cmd.exe&quot; /c rmdir /s /q &quot;%APPDATA%\TikStream&quot; 2&gt;nul &amp; rmdir /s /q &quot;%LOCALAPPDATA%\TikStream&quot; 2&gt;nul &amp; reg delete &quot;HKCU\Software\TikStream&quot; /f 2&gt;nul &amp; reg delete &quot;HKCU\Software\Microsoft\Windows\CurrentVersion\Run&quot; /v TikStream /f 2&gt;nul"
                 Before="PurgeUserDataOnUninstall"
                 Sequence="execute"
                 Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    <CustomAction Id="PurgeUserDataOnUninstall"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec64"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="ResetFreshUserData" After="InstallFinalize" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT REMOVE" />
      <Custom Action="PurgeUserDataOnUninstall" After="InstallFinalize" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- Launch application after installation -->
    <CustomAction Id="LaunchTikStream"
                  Directory="INSTALLFOLDER"
                  ExeCommand="[INSTALLFOLDER]TikStream.exe [SHORTCUT_ARGS]"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="TikStream" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="TikStream" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <StandardDirectory Id="AppDataFolder">
      <Directory Id="TikStreamAppDataFolder" Name="TikStream" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="TikStream" Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentRef Id="MainExecutable" />
      <ComponentGroupRef Id="StageFiles" />
      <ComponentRef Id="StartMenuShortcutComp" />
      <ComponentRef Id="DesktopShortcutComp" />
      <ComponentRef Id="AutostartRegistryComp" />
    </Feature>

    <!-- Main executable + store install folder for future upgrades/reinstalls -->
    <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="2B9D4E11-1C34-4B78-8F21-9A0C6E3B2D14">
      <File Id="TikStreamExe" Source="stage\TikStream.exe" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\TikStream" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" />
    </Component>

    <!-- All remaining runtime files from clean stage directory -->
    <ComponentGroup Id="StageFiles" Directory="INSTALLFOLDER">
      <Files Include="stage\**">
        <Exclude Files="stage\TikStream.exe" />
      </Files>
    </ComponentGroup>

    <!-- Start Menu shortcuts -->
    <Component Id="StartMenuShortcutComp" Directory="ApplicationProgramsFolder" Guid="4A7C1D82-5B63-4E91-A123-7D8E9F012B34" Condition="INSTALL_STARTMENU = 1">
      <Shortcut Id="StartMenuShortcut"
                Name="TikStream"
                Description="TikTok LIVE streaming application"
                Target="[INSTALLFOLDER]TikStream.exe"
                Arguments="[SHORTCUT_ARGS]"
                WorkingDirectory="INSTALLFOLDER"
                Icon="TikStreamIcon.ico" />
      <Shortcut Id="UninstallShortcut"
                Name="Uninstall TikStream"
                Description="Removes TikStream from your computer"
                Target="[System64Folder]msiexec.exe"
                Arguments="/x [ProductCode]" />
      <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\TikStream\Installer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Desktop shortcut -->
    <Component Id="DesktopShortcutComp" Directory="DesktopFolder" Guid="8E2F5A93-3D14-4C82-B456-1E2F3A4B5C67" Condition="INSTALL_DESKTOP = 1">
      <Shortcut Id="DesktopShortcut"
                Name="TikStream"
                Description="TikTok LIVE streaming application"
                Target="[INSTALLFOLDER]TikStream.exe"
                Arguments="[SHORTCUT_ARGS]"
                WorkingDirectory="INSTALLFOLDER"
                Icon="TikStreamIcon.ico" />
      <RegistryValue Root="HKCU" Key="Software\TikStream\Installer" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Start with Windows -->
    <Component Id="AutostartRegistryComp" Directory="INSTALLFOLDER" Guid="C1D2E3F4-9A8B-4C7D-8E6F-5A4B3C2D1E0F" Condition="INSTALL_AUTOSTART = 1">
      <RegistryValue Root="HKCU"
                     Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="TikStream"
                     Type="string"
                     Value="[AUTOSTART_CMD]"
                     KeyPath="yes" />
    </Component>

    <UIRef Id="TikStreamUI" />
    <UIRef Id="WixUI_ErrorProgressText" />

  </Package>
</Wix>
